# ============================================================
# Configuración para Sistema Distribuido con gRPC
# Copiar a .env y ajustar según el nodo
# ============================================================

APP_NAME="Panaderia-Wemby-SD"
APP_ENV=production
APP_KEY=base64:+i8mPNFyWvBKsJp9LxKzQ0m3W2V5X8Y1Z4A7B0C3D6E=
APP_DEBUG=false
APP_URL=http://192.168.1.100

# ============================================================
# Identificación del nodo
# ============================================================
NODE_ID=nodo1                    # Cambiar a: nodo2, nodo3 en otros nodos
NODE_NAME="Nodo 1 - Panaderia"
NODE_IP=192.168.1.11             # IP de este nodo

# ============================================================
# Base de Datos (Galera Cluster)
# ============================================================
DB_CONNECTION=mysql
DB_HOST=mysql                    # En Docker: 'mysql', En LXC: '192.168.1.11'
DB_PORT=3306
DB_DATABASE=sd_app
DB_USERNAME=sdapp
DB_PASSWORD=sdapppass

# ============================================================
# Redis (Caché, Sessions, Queue)
# ============================================================
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis                 # En Docker: 'redis', En LXC: '192.168.1.11'
REDIS_PASSWORD=redispass
REDIS_PORT=6379

# ============================================================
# gRPC Configuration
# ============================================================
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_TIMEOUT=5

# Direcciones de otros nodos gRPC
GRPC_NODO1=app1:50051            # En Docker. En LXC: 192.168.1.11:50051
GRPC_NODO2=app2:50051            # En Docker. En LXC: 192.168.1.12:50051
GRPC_NODO3=app3:50051            # En Docker. En LXC: 192.168.1.13:50051

# API Key para sincronización
API_KEY=your-secret-api-key-here

# ============================================================
# Logging
# ============================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# En distribución, usar remote logging para centralizar logs
# LOG_CHANNEL=single
# PAPERTRAIL_HOST=example.com
# PAPERTRAIL_PORT=12345

# ============================================================
# Mail
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@panaderia.local"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# AWS (S3 para almacenamiento distribuido)
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================
# Sistema de Caché distribuido
# ============================================================
# Para producción, considera: memcached, redis-cluster, etc.
CACHE_BROADCAST_DRIVER=redis

# ============================================================
# Broadcasting (para websockets entre nodos)
# ============================================================
BROADCAST_DRIVER=redis
BROADCAST_CONNECTION=default

# ============================================================
# Filesystem
# ============================================================
FILESYSTEM_DISK=local
# Para SD, considerar: AWS_S3, digitalocean, etc.

# ============================================================
# Vite
# ============================================================
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=http://192.168.1.100/api
